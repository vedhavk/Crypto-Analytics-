# =============================================================================
# CryptoPulse Environment Variables
# =============================================================================

# Discord / Slack / Telegram Webhook for Real-Time Volatility Alerts
# Discord format: https://discord.com/api/webhooks/{webhook.id}/{webhook.token}
ALERT_WEBHOOK_URL=

# Anomaly Detection Sensitivity Threshold (|Z-Score| >= THRESHOLD triggers alert)
ANOMALY_THRESHOLD=3.0

# Rolling Window Size for Z-score calculation (Number of prior ticks)
ANOMALY_WINDOW_SIZE=30

# Minimum prior samples before scoring
ANOMALY_MIN_SAMPLES=10
