FROM python:3.12-slim

WORKDIR /app

# Install dashboard dependencies
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    clickhouse-connect \
    websockets

# Copy dashboard files
COPY web_app.py ./
COPY cursor_tracker.py ./
COPY multi_exchange_service.py ./
COPY webhook_dispatcher.py ./
COPY static/ static/

CMD ["python", "web_app.py"]
